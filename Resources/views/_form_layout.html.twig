{% use "form_div_layout.html.twig" %}

{# Widget #}
{%- block form_widget_compound -%}
  <div {% with { attr: {class:"collection-container fields-container"} } %}{{ block('widget_container_attributes') }}{% endwith %}>
    {%- if form is rootform -%}
      {{ form_errors(form) }}
    {%- endif -%}
    {% with { formMapper: formMapper|default() } %}{{- block('form_rows') -}}{% endwith %}
    {{- form_rest(form) -}}
  </div>
{%- endblock form_widget_compound -%}


{%- block textarea_widget -%}
  <twig:Austral:Form:Textarea id="{{ id }}" required="{{ required }}" disabled="{{ disabled }}" name="{{ full_name }}" attr="{{ attr }}" value="{{ value }}"/>
{%- endblock textarea_widget -%}

{%- block form_widget_simple -%}
  {%- set type = type|default('text') -%}
  <twig:Austral:Form:Input type="{{ type }}" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" disabled="{{ disabled }}" attr="{{ attr }}" value="{{ value }}"/>
{%- endblock form_widget_simple -%}

{%- block checkbox_widget -%}
  <twig:Austral:Form:Input type="checkbox" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" disabled="{{ disabled }}" attr="{{ attr }}" value="{{ value is defined ? value : null }}" checked="{{ checked }}" >
    {% block picto %}{% if checkboxPicto|default() %}{{ checkboxPicto|raw() }}{% endif %}{% endblock %}
  </twig:Austral:Form:Input>
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
  <twig:Austral:Form:Input type="radio" id="{{ id }}" name="{{ full_name }}" required="{{ required }}" disabled="{{ disabled }}" attr="{{ attr }}" value="{{ value is defined ? value : null }}" checked="{{ checked }}" >
    {% block picto %}{% if checkboxPicto|default() %}{{ checkboxPicto|raw() }}{% endif %}{% endblock %}
  </twig:Austral:Form:Input>
{%- endblock radio_widget -%}

{%- block choice_widget_expanded -%}
  <ul {% with { attr: {class:"field-list-content list-"~name~"-content"} } %}{{ block('widget_container_attributes') }}{% endwith %}>
    {%- for child in form %}
      <li class="field-list-element">
        {{- form_widget(child) -}}
        {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
      </li>
    {% endfor -%}
  </ul>
{%- endblock choice_widget_expanded -%}

{%- block choice_widget_collapsed -%}
    {%- if required and placeholder is none and not placeholder_in_choices and not multiple and (attr.size is not defined or attr.size <= 1) -%}
      {% set required = false %}
    {%- endif -%}
  
    {% set selectContent %}
      {%- if placeholder is not none -%}
        <option value=""{% if placeholder_attr|default({}) %}{% with { attr: placeholder_attr } %}{{ block('attributes') }}{% endwith %}{% endif %}{% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder != '' ? (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) }}</option>
      {%- endif -%}
      {%- if preferred_choices|length > 0 -%}
        {% set options = preferred_choices %}
        {% set render_preferred_choices = true %}
        {{- block('choice_widget_options') -}}
        {%- if choices|length > 0 and separator is not none -%}
          <option disabled="disabled">{{ separator }}</option>
        {%- endif -%}
      {%- endif -%}
      {%- set options = choices -%}
      {%- set render_preferred_choices = false -%}
      {{- block('choice_widget_options') -}}
    {% endset %}
    <twig:Austral:Form:Select id="{{ id }}" name="{{ full_name }}" required="{{ required }}" disabled="{{ disabled }}" attr="{{ attr }}" multiple="{{ multiple }}">
      <twig:block name="choices">
        {{ selectContent|raw()  }}
      </twig:block>
    </twig:Austral:Form:Select>
{%- endblock choice_widget_collapsed -%}

{# Label #}
{% block form_label %}
  {% if label is not same as(false) -%}
    {% if not compound -%}
      {% set label_attr = label_attr|merge({'for': id}) %}
    {%- endif -%}
    {% if required -%}
      {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' required')|trim}) %}
    {%- endif -%}
    {%- if label is empty -%}
      {%- if label_format is not empty -%}
        {% set label = label_format|replace({
          '%name%': name,
          '%id%': id,
        }) %}
      {%- else -%}
        {% set label = name|humanize %}
      {%- endif -%}
    {%- endif -%}
    <twig:Austral:Form:Label
      tag="{{ element|default("label") }}"
      entitled="{{ label }}"
      id="{{ id }}_label"
      attr="{{ label_attr }}"
      translationParameters="{{ attr_translation_parameters }}"
      translationDomain="{{ translation_domain }}"
    />
  {%- endif -%}
{% endblock form_label %}
{%- block button_label -%}{%- endblock -%}


{%- block form_rows -%}
  {% if block_prefixes[1] is defined and block_prefixes[1] == "collection_entry" and formMapper is defined and formMapper-%}
    {% set formMapper = formMapper.getSubFormMapperByKey(block_prefixes[2]) %}
  {% endif %}
  {% for child in form|filter(child => not child.rendered) %}
    {% set field = formMapper ? formMapper.getField(child.vars.name) : null %}
    {{- form_row(child, {
      tag: "div",
      field:  field,
      formMapper: formMapper,
      row_attr: field ? field.options.container : {},
    }) -}}
  {% endfor %}
{%- endblock form_rows -%}

{# Rows #}
{%- block form_row -%}
  {%- set widget_attr = {} -%}
  {%- set row_attr = row_attr is not defined ? {} : row_attr -%}
  {% if field.helper is defined and field.helper %}
    {%- set widget_attr = {attr: {'aria-describedby': id ~"_helper", checkboxPicto: checkboxPicto|default()}, formMapper: formMapper|default()} -%}
  {% elseif help is not empty -%}
    {%- set widget_attr = {attr: {'aria-describedby': id ~"_help", checkboxPicto: checkboxPicto|default()}, formMapper: formMapper|default()} -%}
  {%- endif -%}
  
  
  
  {% set beforeValue = field.before.html|default() %}
  {% if field.before.path|default() %}
    {% set beforeValue = include(field.before.path) %}
  {% elseif field.before.twigComponent.name|default() %}
    {% set beforeValue = component(field.before.twigComponent.name, field.before.twigComponent.parameters) %}
  {% endif %}
  
  {% set afterValue = field.after.html|default() %}
  {% if field.after.path|default() %}
    {% set afterValue = include(field.after.path) %}
  {% elseif field.after.twigComponent.name|default() %}
    {% set afterValue = component(field.after.twigComponent.name, field.after.twigComponent.parameters) %}
  {% endif %}
  
  {%- set labelPosition = labelPosition|default(field.options.labelPosition|default("external")) -%}
  {%- set typeField = block_prefixes[1] is defined  ? block_prefixes[1] : "" -%}
  <twig:Austral:Form:Row tag="{{ tag|default("div") }}"
      attr="{{ row_attr }}"
      typeField="{{ typeField }}"
      name="{{ name }}"
      labelPosition="{{ labelPosition }}"
      reverse="{{ reverse|default(field.reverse|default(false)) }}"
      disabled="{{ disabled|default(field.disabled|default(false)) }}"
      required="{{ required|default(field.required|default(false)) }}"
  >
    <twig:block name="label">
      {%- if labelPosition != "external" -%}
        {{- form_label(form) -}}
      {%- endif -%}
    </twig:block>
    <twig:block name="label_external">
      {%- if labelPosition == "external" -%}
        {{- form_label(form) -}}
      {%- endif -%}
    </twig:block>
    <twig:block name="field">
      {{- form_widget(form, widget_attr) -}}
    </twig:block>
    <twig:block name="error">
      {{- form_errors(form) -}}
    </twig:block>
    <twig:block name="before">
      {{- beforeValue is defined and beforeValue ? beforeValue|raw() : "" -}}
    </twig:block>
    <twig:block name="after">
      {{- afterValue is defined and afterValue ? afterValue|raw() : "" -}}
    </twig:block>
    <twig:block name="helper">
      {%- if field.helper is defined and field.helper -%}
        <ul id="{{ id }}_helper" class="helper-content">
          <li class="value">{{ field.helper|trans() }}</li>
        </ul>
      {%- else -%}
        {{- form_help(form) -}}
      {%- endif -%}
    </twig:block>
  </twig:Austral:Form:Row>
{%- endblock form_row -%}

{%- block form_errors -%}
  {%- if errors|length > 0 -%}
    <div class="errors-content" data-fieldname="{{ name }}">
      <ul>
        {%- for error in errors -%}
          <li>{{ error.message }}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
{%- endblock form_errors -%}

{# Support #}
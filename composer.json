{
  "name": "austral/form-bundle",
  "type": "symfony-bundle",
  "description": "Form builder and mapper for Austral",
  "keywords": [
    "Austral",
    "Mapper",
    "Form"
  ],
  "license": "MIT",
  "homepage": "https://austral.dev",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4 <9.0",
    "austral/contracts": "^4.0",
    "austral/entity-bundle": "^4.0",
    "austral/tools-bundle": "^4.0",
    "symfony/routing": "^7.4",
    "symfony/form": "^7.4",
    "symfony/validator": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/options-resolver": "^7.4",
    "symfony/string": "^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Austral\\FormBundle\\": "src/"
    }
  },
  "autoload-dev": {
  "psr-4": {
    "Austral\\FormBundle\\Tests\\": "tests/"
  }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

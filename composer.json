{
  "name": "austral/form-bundle",
  "type": "symfony-bundle",
  "description": "Form builder and mapper for Austral",
  "keywords": [
    "Austral",
    "Mapper",
    "Form"
  ],
  "license": "MIT",
  "homepage": "https://austral.dev",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4 <9.0",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^3.3 || ^4.0",
    "symfony/doctrine-bridge": "^7.4",
    "symfony/form": "^7.4",
    "symfony/yaml": "^7.4",
    "symfony/validator": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/options-resolver": "^7.4",
    "symfony/string": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.4",
    "symfony/property-access": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/http-client-contracts": "^3.0",
    "symfony/translation-contracts": "^3.0",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/http-kernel": "^7.4"
  },
  "require-dev": {
    "twig/twig": "^3.0",
    "symfony/twig-bridge": "^7.4",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Austral\\FormBundle\\": "src/"
    }
  },
  "autoload-dev": {
  "psr-4": {
    "Austral\\FormBundle\\Tests\\": "tests/"
  }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
